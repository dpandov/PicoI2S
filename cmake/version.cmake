# Writes the build identity header OUT at every build: the build number
# (commits in HEAD), the commit, whether the tracked files differ from it,
# and the build time (UTC). Without git: build 0, commit "unknown".
#   cmake -DOUT=<header> -DSRC=<repo> [-DGIT=<git>] -P version.cmake

set(build 0)
set(commit unknown)
set(dirty 0)
if(GIT)
    execute_process(COMMAND "${GIT}" -C "${SRC}" rev-list --count HEAD
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0)
        set(build ${out})
        execute_process(COMMAND "${GIT}" -C "${SRC}" rev-parse --short=7 HEAD
                        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND "${GIT}" -C "${SRC}" status --porcelain
                                --untracked-files=no --ignore-submodules=dirty
                        OUTPUT_VARIABLE out ERROR_QUIET)
        if(NOT out STREQUAL "")
            set(dirty 1)
        endif()
    endif()
endif()
string(TIMESTAMP date "%Y-%m-%dT%H:%MZ" UTC)

set(text "// Generated by cmake/version.cmake at every build.
#pragma once
#define PICOI2S_BUILD_NUMBER ${build}
#define PICOI2S_BUILD_COMMIT \"${commit}\"
#define PICOI2S_BUILD_DIRTY  ${dirty}
#define PICOI2S_BUILD_DATE   \"${date}\"
")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
